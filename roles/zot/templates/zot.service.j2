[Unit]
Description=zot OCI image registry
Documentation=https://zotregistry.dev
After=network-online.target
Wants=network-online.target

# The store may be a separately mounted volume, and nothing else connects the two:
# without this, a volume that failed to mount would leave zot serving an empty
# store from the root filesystem and accepting pushes into it. Resolves to the
# root mount, and so is a no-op, when there is no dedicated volume.
RequiresMountsFor={{ zot_storage_root }}

[Service]
ExecStart={{ zot_install_path }} serve {{ zot_config_dir }}/config.json
Restart=always
RestartSec=1

# Port 5000 is unprivileged; zot only needs to read /etc/zot and write its image store, so
# it runs as a dedicated locked-down user. With ProtectSystem=strict the store is the only
# writable path; it is owned by the service user and may be a separately mounted volume
# (see tasks/storage.yml).
User={{ zot_user }}
Group={{ zot_user }}
ReadWritePaths={{ zot_storage_root }}
{% if zot_log_file | bool or zot_audit_log | bool %}
# /var/log/zot, created for the service user and writable despite ProtectSystem.
LogsDirectory=zot
LogsDirectoryMode=0750
{% endif %}
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
LoadCredential=zot-server-key.pem:{{ zot_config_dir }}/zot-server-key.pem

[Install]
WantedBy=multi-user.target
