{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "{{ zot_storage_root }}"
  },
  "http": {
    "address": "{{ zot_address }}",
    "port": "{{ zot_port }}",
    "readTimeout": "{{ zot_read_timeout }}",
    "writeTimeout": "{{ zot_write_timeout }}",
    "compat": ["docker2s2"],
    "tls": {
      "cert": "{{ zot_config_dir }}/zot-server-cert.pem",
      "key": "/run/credentials/zot.service/zot-server-key.pem",
      "cacert": "{{ zot_config_dir }}/zot-ca-cert.pem"
    },
    "auth": {
      "mtls": {
        "identityAttributes": ["CommonName"]
      }
    },
    "accessControl": {
      "repositories": {
        "**": {
          "policies": [
            {
              "users": ["cmgr"],
              "actions": ["read", "create", "update", "delete"]
            },
            {
              "users": {{ zot_worker_identities | to_json }},
              "actions": ["read"]
            }
          ],
          "defaultPolicy": [],
          "anonymousPolicy": []
        }
      }
    }
  },
  "log": {{ {'level': zot_log_level}
            | combine({'output': zot_log_path} if zot_log_file | bool else {})
            | combine({'audit': zot_audit_log_path} if zot_audit_log | bool else {})
            | to_json }}
}
