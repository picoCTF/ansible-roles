{#
  Protects the host's own working set from reclaim pressure generated by
  challenge containers. Capping the container slice bounds what containers may
  allocate; it does nothing to stop the kernel reclaiming dockerd, containerd
  and sshd pages to satisfy those allocations.
#}
[Slice]
# Hard floor. memory.min never reserves unused headroom -- it only protects pages
# the slice is actually using -- so sizing it to the real working set costs no
# capacity and is the part that genuinely survives sustained pressure.
MemoryMin={{ system_slice_memory_min_mb }}M
# Best-effort floor, given up only when there is no alternative. Derived from the
# host reserve this worker was sized against, so it tracks instance size and
# container count rather than contradicting them.
MemoryLow={{ system_slice_memory_low_mb | int }}M
