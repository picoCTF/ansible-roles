# dockerd's data-root is on the separate XFS volume (see daemon.json), and
# nothing else connects the two. Without this, a data volume that fails to
# mount leaves dockerd running perfectly happily on a directory of the same
# name on the root volume: a fraction of the space, and no XFS project quotas,
# which is the entire reason the volume exists. Nothing reports it. The first
# sign is a challenge filling the root disk.
#
# Requiring the mount turns that into a clean stop: dockerd does not start, so
# cork cannot reach the worker, the launch lifecycle hook never sees it report
# ok, and it is abandoned and replaced rather than joining the fleet in a state
# where it cannot enforce a quota.
#
# Note what this does NOT do. cork-telemetry has no dependency on docker.service
# and reads only /proc/stat and /proc/meminfo, so it still answers 200 on a
# worker whose dockerd refused to start -- the endpoint is a load signal, not a
# health check. The fstab entry carries nofail for the same reason: without it
# the failure lands on local-fs.target instead and the instance never gets far
# enough to refuse anything, or to be logged into.
#
# Requires= also only propagates a deliberate stop, which is what is wanted.
# Unmounting the volume by hand leaves dockerd running; pulling it down with the
# daemon would need BindsTo=, and other units order themselves after
# docker.service, so a stop that propagates reaches further than this drop-in
# has any business reaching.
[Unit]
RequiresMountsFor={{ storage_mount_point }}
