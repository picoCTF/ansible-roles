[Unit]
Description=cork daemon
Documentation=https://github.com/CyLabAcademy/challenge-orchestrator
{% if cork_build_plane != "external" %}
Wants=docker.service
After=docker.service
{% endif %}
ConditionArchitecture={{ cork_condition_architecture }}
{% if cork_build_plane != "external" %}
ConditionPathIsDirectory={{ cork_dir }}
{% endif %}

[Service]
Type=exec
LimitNOFILE=49152
Environment="CORK_BUILD_PLANE={{ cork_build_plane }}"
Environment="CORK_DB={{ cork_db }}"
Environment="CORK_LOGGING={{ cork_logging }}"
{#
  An external daemon reads neither of these and names them at startup if they
  are set: it holds no challenge tree, and artifact bundles stay on the build
  plane that wrote them.
#}
{% if cork_build_plane != "external" %}
Environment="CORK_DIR={{ cork_dir }}"
Environment="CORK_ARTIFACT_DIR={{ cork_artifact_dir }}"
{% endif %}
{#
  Kept on an external daemon as well: it drives the workers over mTLS, and cork
  warns at startup when this is missing.
#}
Environment="DOCKER_CERT_PATH={{ docker_cert_path }}"
{% if cork_registry %}
Environment="CORK_REGISTRY={{ cork_registry }}"
{% endif %}
{% if cork_registry_cert_dir %}
Environment="CORK_REGISTRY_CERT_DIR={{ cork_registry_cert_dir }}"
{% endif %}
{% if cork_build_plane != "external" and cork_purge_after_push is not none %}
Environment="CORK_PURGE_AFTER_PUSH={{ cork_purge_after_push | bool | ternary('on', 'off') }}"
{% endif %}
{% if cork_ports %}
Environment="CORK_PORTS={{ cork_ports }}"
{% endif %}
{% if cork_concurrent_launches %}
Environment="CORK_CONCURRENT_LAUNCHES={{ cork_concurrent_launches }}"
{% endif %}
{% if cork_prune_age %}
Environment="CORK_PRUNE_AGE={{ cork_prune_age }}"
{% endif %}
{% if cork_db_wal is not none %}
Environment="CORK_DB_WAL={{ cork_db_wal | bool | ternary('on', 'off') }}"
{% endif %}
{% if cork_enable_disk_quotas %}
Environment="CORK_ENABLE_DISK_QUOTAS={{ cork_enable_disk_quotas }}"
{% endif %}
{% if cork_build_plane != "external" and cork_base_pins %}
Environment="CORK_BASE_PINS={{ cork_base_pins }}"
{% endif %}
{% for key, value in cork_extra_environment_vars.items() %}
Environment="{{ key }}={{ value }}"
{% endfor %}
ExecStart={{ install_location }}/{{ cork_daemon_binary }}

[Install]
WantedBy=multi-user.target
